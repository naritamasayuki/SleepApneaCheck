    "error.mic.permission_denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone permission is required to record sleep audio. Please enable it in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠録音を行うにはマイクへのアクセス許可が必要です。設定アプリから許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制睡眠声音需要麦克风权限，请在“设置”中开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製睡眠聲音需要麥克風權限，請在「設定」中開啟。"
          }
        }
      }
    },
