    },
    "ess.q3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Sitting inactive in a public place (e.g. theater or meeting)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 会議や映画館など公の場で静かに座っているとき"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 在公共场所（如剧场或会议）安静坐着时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 在公共場所（如劇場或會議）安靜坐著時"
          }
        }
      }
    },
    "ess.q4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. As a passenger in a car for an hour without a break"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 休憩なしで1時間ほど車に同乗しているとき"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 连续乘车一小时不休息时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 連續乘車一小時不休息時"
          }
        }
      }
    },
    "ess.q5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Lying down to rest in the afternoon"
          }
