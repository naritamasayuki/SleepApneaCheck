    "risk.high.advice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High risk of obstructive sleep apnea. Consulting a sleep clinic or respiratory specialist is strongly recommended."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠時無呼吸症候群（OSA）の高リスク傾向があります。睡眠外来・呼吸器内科・耳鼻咽喉科などの専門医への受診を強くおすすめします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻塞性睡眠呼吸暂停风险较高，强烈建议前往睡眠医学科或呼吸内科就诊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻塞性睡眠呼吸中止風險較高，強烈建議前往睡眠醫學科或胸腔內科就診。"
          }
        }
      }
    },
    "risk.high.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High Risk"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高リスク"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高风险"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高風險"
          }
        }
      }
    },
    "risk.intermediate.advice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate risk detected. Consider monitoring your sleep audio and consulting a doctor if daytime sleepiness persists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中程度のリスクがあります。睡眠録音による経過観察や、日中の眠気・いびきが続く場合は医療機関への相談をご検討ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在中等风险。建议配合睡眠录音监测，若日间嗜睡持续请咨询医生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存在中等風險。建議配合睡眠錄音監測，若日間嗜睡持續請諮詢醫師。"
          }
        }
      }
    },
    "risk.intermediate.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intermediate Risk"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中リスク"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中风险"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中風險"
          }
        }
      }
    },
    "risk.low.advice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low screening risk. Continue healthy sleep habits and recheck if symptoms change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現時点では低リスクです。規則正しい睡眠習慣を心がけ、いびきや眠気の変化があれば再度チェックしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前筛查风险较低。请保持规律作息，如症状有变化请重新检测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前篩檢風險較低。請保持規律作息，如症狀有變化請重新檢測。"
          }
        }
      }
    },
