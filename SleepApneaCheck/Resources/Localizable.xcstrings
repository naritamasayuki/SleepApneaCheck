    "legal.privacy_policy.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SleepApnea Check stores all questionnaire results and sleep audio recordings locally on your device. No audio recordings or personal health responses are uploaded to external servers. Microphone access is used solely for sleep sound analysis on your device. You may delete all stored data at any time from Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「睡眠時無呼吸チェック」（SleepApnea Check）は、問診結果および睡眠録音データをすべてお使いの端末内にのみ保存します。録音音声や回答データが外部サーバーへ送信されることはありません。マイク権限は端末内での睡眠音解析にのみ使用されます。保存データは設定画面からいつでもすべて削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠呼吸暂停检测（SleepApnea Check）将所有问卷结果和睡眠录音仅保存在您的设备本地，不会上传至外部服务器。麦克风权限仅用于设备本地的声音分析。您可随时在设置中清除所有数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠呼吸中止檢測（SleepApnea Check）將所有問卷結果與睡眠錄音僅儲存在您的裝置本機，不會上傳至外部伺服器。麥克風權限僅用於裝置本機的聲音分析。您可隨時在設定中清除所有資料。"
          }
        }
      }
    },
    "legal.privacy_policy.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy Policy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーポリシー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐私政策"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隱私權政策"
          }
        }
      }
    },
    "legal.terms.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Medical Disclaimer: This application is a self-check screening tool and is NOT a medical device. It does not provide medical diagnosis or treatment.\n\n2. Subscriptions: Payment will be charged to your Apple ID account upon confirmation of purchase. Subscriptions automatically renew unless canceled at least 24 hours before the end of the current period."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 医療免責事項：本アプリはセルフチェック用の補助ツールであり、医療機器ではありません。医学的診断や治療を提供するものではありません。\n\n2. サブスクリプション：購入確認時にApple IDアカウントへ課金されます。現在の契約期間終了の24時間前までに解約しない限り、自動的に更新されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 医疗免责声明：本应用仅为自我筛查辅助工具，并非医疗器械，不提供医疗诊断或治疗。\n\n2. 订阅条款：确认购买时将向您的 Apple ID 账户扣款。除非在当前订阅期结束前至少 24 小时取消，否则订阅将自动续订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 醫療免責聲明：本應用程式僅供自我篩檢輔助使用，並非醫療器材，不提供醫療診斷或治療。\n\n2. 訂閱條款：確認購買時將向您的 Apple ID 帳號扣款。除非在目前訂閱期結束前至少 24 小時取消，否則訂閱將自動續訂。"
          }
        }
      }
    },
    "legal.terms.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terms of Use"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用規約"
