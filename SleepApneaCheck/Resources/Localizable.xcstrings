    "disclaimer.banner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is a self-check screening tool and is not a medical device. It does not provide a medical diagnosis. If you have concerns or high-risk results, please consult a sleep specialist or physician."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本アプリはセルフチェック用の補助ツールであり、医療機器ではありません。医学的診断を行うものではないため、不安がある場合や高リスク判定が出た場合は専門医を受診してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用仅为自我筛查辅助工具，并非医疗器械，不提供医疗诊断。如有疑虑或结果为高风险，请咨询专业医生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用程式僅供自我篩檢輔助使用，並非醫療器材，無法提供醫療診斷。如有疑慮或結果為高風險，請諮詢專科醫師。"
          }
        }
      }
    },
    "error.audio.empty_data": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recorded audio file is empty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音データが空のため解析できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音数据为空，无法分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音資料為空，無法分析。"
          }
        }
      }
    },
    "error.audio.invalid_format": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported audio format."
          }
        },
