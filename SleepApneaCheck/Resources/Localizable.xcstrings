          "stringUnit": {
            "state": "translated",
            "value": "無法開啟音訊檔案進行分析。"
          }
        }
      }
    },
    "error.audio.playback_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to play back the recording."
