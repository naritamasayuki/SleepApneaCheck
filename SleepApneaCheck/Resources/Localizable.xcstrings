    "legal.privacy_policy.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SleepApnea Check stores all questionnaire results and sleep audio recordings locally on your device. No audio recordings or personal health responses are uploaded to our servers. Data read from Apple Health (HealthKit) is used solely for on-device display and is never used for advertising or marketing or shared with third parties. For ad delivery, Google AdMob may collect device identifiers, advertising data, and diagnostics in accordance with your tracking/consent settings. You may delete all stored data at any time from Settings. Contact: doronko.narunaru@gmail.com"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「睡眠時無呼吸チェック」（SleepApnea Check）は、問診結果および睡眠録音データをすべてお使いの端末内にのみ保存します。録音音声や健康に関する回答データが当方のサーバーへ送信されることはありません。Apple ヘルスケア（HealthKit）から読み取ったデータは端末内での表示にのみ使用し、広告・マーケティングへの利用や第三者への提供は一切行いません。なお、バナー広告配信のため Google AdMob が広告識別子・広告データ・診断情報等を取得する場合があります（トラッキング許可・同意設定に従います）。保存データは設定画面からいつでもすべて削除できます。お問い合わせ: doronko.narunaru@gmail.com"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠呼吸暂停检测（SleepApnea Check）将所有问卷结果和睡眠录音仅保存在您的设备本地，不会上传至我们的服务器。从 Apple 健康（HealthKit）读取的数据仅用于设备本地显示，绝不用于广告或营销，也不会提供给第三方。为展示横幅广告，Google AdMob 可能会根据您的跟踪与同意设置收集设备标识符、广告数据和诊断信息。您可随时在设置中清除所有数据。联系方式：doronko.narunaru@gmail.com"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠呼吸中止檢測（SleepApnea Check）將所有問卷結果與睡眠錄音僅儲存在您的裝置本機，不會上傳至我們的伺服器。從 Apple 健康（HealthKit）讀取的資料僅用於裝置本機顯示，絕不用於廣告或行銷，亦不提供給第三方。為顯示橫幅廣告，Google AdMob 可能會依據您的追蹤與同意設定收集裝置識別碼、廣告資料與診斷資訊。您可隨時在設定中清除所有資料。聯絡方式：doronko.narunaru@gmail.com"
          }
        }
      }
    },
