    "screening.section.ess.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rate your chance of dozing off in each situation (0: Never to 3: High)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各場面でうとうと眠ってしまう可能性を 0〜3 で選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请评估在以下场景中打瞌睡的可能性（0：从不 至 3：很高）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請評估在以下情境中打瞌睡的可能性（0：從不 至 3：很高）。"
          }
        }
      }
    },
