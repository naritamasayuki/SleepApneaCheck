    "quickcheck.disclaimer.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This quick check result is for reference only and is NOT a medical diagnosis. Even a low-risk result does not rule out sleep apnea. Please consult a qualified physician for formal testing such as polysomnography."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この簡易判定はセルフチェックの目安であり、医学的診断を行うものではありません。低リスク判定であっても疾患を否定するものではないため、症状が続く場合は医療機関での精密検査をご検討ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本快速评估仅供参考，不构成任何医疗诊断。即使结果为低风险也不能完全排除睡眠呼吸暂停，如有持续症状请前往医院进行专业检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本快速評估僅供參考，不構成任何醫療診斷。即使結果為低風險也不能完全排除睡眠呼吸中止，如有持續症狀請前往醫院進行專業檢查。"
          }
        }
      }
    },
    "quickcheck.disclaimer.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medical Disclaimer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "簡易判定に関する免責事項"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "医疗免责声明"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "醫療免責聲明"
          }
        }
      }
    },
    "quickcheck.q1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Do you snore loudly almost every night?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. ほぼ毎晩、大きないびきをかきますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 您是否几乎每晚都会响亮地打鼾？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 您是否幾乎每晚都會響亮地打鼾？"
          }
        }
      }
    },
    "quickcheck.q2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2. Has anyone told you that your breathing stops or chokes during sleep?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 睡眠中に呼吸が止まる・むせると指摘されたことはありますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 是否有人告诉过您睡觉时呼吸暂停或被憋醒？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "2. 是否有人告訴過您睡覺時呼吸暫停或被憋醒？"
          }
        }
      }
    },
    "quickcheck.q3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Do you often feel strong daytime sleepiness or fatigue?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 日中に強い眠気やだるさを感じることが多いですか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 白天是否经常感到强烈的嗜睡或疲劳？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "3. 白天是否經常感到強烈的嗜睡或疲勞？"
          }
        }
      }
    },
    "quickcheck.q4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Do you often wake up with a dry mouth, headache, or unrefreshed sleep?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 起床時の口の渇き・頭痛・熟睡感のなさがよくありますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 醒来时是否常感到口干、头痛或睡眠不足？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 醒來時是否常感到口乾、頭痛或睡眠不足？"
          }
        }
      }
    },
    "quickcheck.q5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Do you have high blood pressure or a tendency toward obesity?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5. 高血圧がある、または肥満傾向と言われたことがありますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5. 您是否有高血压或超重/肥胖倾向？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5. 您是否有高血壓或過重/肥胖傾向？"
          }
        }
      }
    },
    "quickcheck.result.high_summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Key warning signs of sleep apnea (such as observed breathing pauses or multiple symptoms) are present. Consulting a sleep specialist is recommended."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠時無呼吸症候群の注意サイン（呼吸停止の指摘や複数の該当項目）が見られます。早めの専門医へのご相談をおすすめします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到睡眠呼吸暂停的重要警示信号（如呼吸暂停或多症状并存），建议尽早咨询睡眠专科医生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到睡眠呼吸中止的重要警示訊號（如呼吸暫停或多症狀並存），建議儘早諮詢睡眠專科醫師。"
          }
        }
      }
    },
    "quickcheck.result.intermediate_summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some sleep-related symptoms were found. We recommend taking the detailed STOP-Bang check and monitoring your sleep audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかの睡眠関連サインが該当します。詳細問診（STOP-Bang）や睡眠録音による経過確認をおすすめします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在部分睡眠相关症状，建议进一步进行详细问卷筛查并配合睡眠录音监测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存在部分睡眠相關症狀，建議進一步進行詳細問卷篩檢並配合睡眠錄音監測。"
          }
        }
      }
    },
    "quickcheck.result.low_summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Few warning signs were reported in this quick check. Maintain healthy sleep habits and recheck if symptoms appear."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現時点では簡易チェック上のリスクサインは少なめです。引き続き睡眠習慣を整え、気になる症状が出た際は再チェックしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次快速检测未发现明显高风险信号。请继续保持良好的睡眠习惯，如有症状变化请再次检测。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次快速檢測未發現明顯高風險訊號。請持續保持良好的睡眠習慣，如有症狀變化請再次檢測。"
          }
        }
      }
    },
