        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音ファイルが見つかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到录音文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到錄音檔案。"
          }
        }
      }
    },
    "error.audio.open_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to open the audio file for analysis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解析用の音声ファイルを開けませんでした。"
