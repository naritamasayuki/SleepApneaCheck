    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access is used to record sleep sounds and analyze snoring or breathing pause patterns."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠中のいびきや無呼吸の傾向を簡易解析するため、マイクによる録音を使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用麦克风录制睡眠声音，以分析打鼾和呼吸暂停趋势。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要使用麥克風錄製睡眠聲音，以分析打鼾和呼吸中止趨勢。"
          }
        }
      }
