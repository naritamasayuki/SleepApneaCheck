{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SleepApnea Check"
          }
        },
        "ja": {
          "stringUnit": {
